# Public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only - NEVER expose
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# First admin (used only by: npm run create-admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-long-unique-password

# ---- Part 2 ----
# Email (Resend: https://resend.com — verify your sending domain first)
RESEND_API_KEY=
EMAIL_FROM="Khwaja Quran Majeed Academy <no-reply@your-domain.com>"
ADMIN_NOTIFY_EMAIL=            # fallback if Admin → Settings contact email is empty
CRON_SECRET=                   # any long random string; Vercel cron sends it automatically
# Live classes (LiveKit Cloud or self-hosted)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set to true AFTER the admin has enrolled an authenticator at /admin/security
ADMIN_REQUIRE_MFA=false
